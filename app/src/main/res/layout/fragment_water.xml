<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/water_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:background="@color/pulse_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="@dimen/scroll_clearance_bottom"
        android:clipToPadding="false">

        <!-- Top Header Bar: Title on left, Notification reminder toggle on right -->
        <LinearLayout
            android:id="@+id/header_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Title & Subtitle (Far Left) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_water_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/water_title"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textColor="@color/pulse_text_primary" />

                <TextView
                    android:id="@+id/text_water_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/water_subtitle"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/pulse_text_secondary" />
            </LinearLayout>

            <!-- Circular Notification reminder toggle button (42dp x 42dp circle card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_water_reminder_toggle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/water_reminder_toggle_desc">

                <ImageView
                    android:id="@+id/icon_water_reminder_toggle"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/pulse_on_nav_active"
                    android:contentDescription="@null" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Top Sky Blue Hero Box: 16dp horizontal, 18dp top, 28dp radius, Sky Blue (#8BA0FF) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_water_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/pulse_sky_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="210dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="18dp">

                <!-- LEFT SIDE (Ring): CircularProgressView with thick 19dp ring & center percentage only -->
                <com.pulse.tracker.ui.common.CircularProgressView
                    android:id="@+id/hero_water_progress_view"
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:layout_marginEnd="36dp"
                    app:cpv_max="2500"
                    app:cpv_currentSteps="0"
                    app:cpv_progress="0.0"
                    app:cpv_strokeWidth="19dp"
                    app:cpv_trackColor="@color/pulse_progress_track"
                    app:cpv_progressColor="@color/pulse_on_sky_blue"
                    app:cpv_percentTextColor="@color/pulse_on_sky_blue"
                    app:cpv_percentTextSize="28sp"
                    app:cpv_centerPercentageOnly="true" />

                <!-- RIGHT SIDE (Text Column): "Intake today", big current ml, "out of X ml" -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/label_hero_water"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_hero_intake_label"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/pulse_on_container_secondary" />

                    <TextView
                        android:id="@+id/text_water_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="46sp"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/pulse_on_sky_blue"
                        android:includeFontPadding="false"
                        tools:text="0" />

                    <!-- Target Row under current ml number -->
                    <LinearLayout
                        android:id="@+id/row_water_target"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/text_water_out_of"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_out_of"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/pulse_on_container_tertiary" />

                        <TextView
                            android:id="@+id/text_water_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif"
                            android:textStyle="bold"
                            android:layout_marginLeft="8dp"
                            android:textColor="@color/pulse_on_sky_blue"
                            tools:text="2,500 ml" />
                    </LinearLayout>

                    <!-- Remaining Target Subtitle -->
                    <TextView
                        android:id="@+id/text_water_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="2,500 ml remaining"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/pulse_on_container_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Log Bento Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/water_section_quick_log"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/pulse_text_secondary" />

                <!-- Proper Reset Today Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_water_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/pulse_track_inactive"
                    app:cardBackgroundColor="@color/pulse_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_reset_today"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="@color/pulse_text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 3 Quick Add Bento Cards: +250 ml (Drop), +500 ml (Glass), +750 ml (Bottle) - White as bottom nav -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:baselineAligned="false">

                <!-- Card 1: 250 ml (Water Drop Icon) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_add_250"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="8dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_water_drop"
                            app:tint="@color/pulse_on_nav_active"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_quick_add_250"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_on_nav_active" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/water_quick_add_small_glass"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_text_tertiary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: 500 ml (Water Glass Icon) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_add_500"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="8dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_water_glass"
                            app:tint="@color/pulse_on_nav_active"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_quick_add_500"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_on_nav_active" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/water_quick_add_large_glass"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_text_tertiary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 3: 750 ml (Water Bottle Icon) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_add_750"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="8dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_water_bottle"
                            app:tint="@color/pulse_on_nav_active"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_quick_add_750"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_on_nav_active" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/water_quick_add_bottle"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_text_tertiary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Section Label: Scientific Hydration Breakdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/water_section_breakdown"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/pulse_text_secondary" />

        <!-- Metric / Insight Bento Card (#222222, 28dp radius, #333333 stroke) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_water_breakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardBackgroundColor="@color/pulse_yellow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header: Title on Left, Methodology Pill on Right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/water_target_formula_title"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/pulse_on_yellow"
                        android:textStyle="bold" />

                    <!-- Formula Pill: "EFSA / IOM" -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/pulse_accent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/water_formula_efsa_iom"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="@color/pulse_on_yellow" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/water_formula_explanation"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/pulse_on_container_tertiary"
                    android:layout_marginBottom="18dp" />

                <!-- Row 1: Base Intake (Weight & Gender) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_breakdown_base_title"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/pulse_on_yellow" />

                        <TextView
                            android:id="@+id/text_breakdown_base_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="70.0 kg • Male (35 ml/kg)"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_on_container_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_breakdown_base_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="2,450 ml"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_on_yellow" />
                </LinearLayout>

                <!-- Row 2: Body Surface Area (BSA) Evaporative Loss -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_breakdown_bsa_title"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/pulse_on_yellow" />

                        <TextView
                            android:id="@+id/text_breakdown_bsa_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="170 cm • DuBois formula"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_on_container_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_breakdown_bsa_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="+35 ml"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_on_yellow" />
                </LinearLayout>

                <!-- Row 3: Age Demographic Factor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_breakdown_age_title"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/pulse_on_yellow" />

                        <TextView
                            android:id="@+id/text_breakdown_age_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="30 years • Standard adult"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_on_container_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_breakdown_age_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0 ml"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_on_yellow" />
                </LinearLayout>

                <!-- Row 4: Step Activity Compensation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_breakdown_activity_title"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/pulse_on_yellow" />

                        <TextView
                            android:id="@+id/text_breakdown_steps_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="Daily physical movement"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/pulse_on_container_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_breakdown_steps_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0 ml"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_on_yellow" />
                </LinearLayout>

                <!-- Divider line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/pulse_outline"
                    android:layout_marginBottom="14dp" />

                <!-- Total Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/water_breakdown_total_title"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_on_yellow" />

                    <TextView
                        android:id="@+id/text_breakdown_total_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="2,500 ml"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_on_yellow" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
