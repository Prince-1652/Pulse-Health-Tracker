<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_onboarding_page3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="24dp"
        android:paddingBottom="130dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_height_title"
                android:textSize="28sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:textColor="@color/pulse_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/onboarding_height_desc"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/pulse_text_secondary" />
        </LinearLayout>

        <!-- Bento Card: Height Measuring Tape (Solid Neutral #222222, 28dp radius) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_onboarding_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/pulse_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_16">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sliders"
                        app:tint="@color/pulse_sky_blue"
                        android:contentDescription="@null"
                        android:layout_marginEnd="@dimen/space_12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_height_calibration_title"
                        android:textAppearance="@style/TextAppearance.Pulse.TitleLarge"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_text_primary" />
                </LinearLayout>

                <!-- Measuring Tape Bento Block -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/pulse_surface_alt">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_height"
                                android:textAppearance="@style/TextAppearance.Pulse.TitleMedium"
                                android:textColor="@color/pulse_text_secondary"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="true">

                                <TextView
                                    android:id="@+id/text_onboarding_height_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="170"
                                    android:textSize="40sp"
                                    android:fontFamily="sans-serif"
                                    android:textStyle="bold"
                                    android:textColor="@color/pulse_text_primary"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/text_onboarding_height_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unit_suffix_cm_spaced"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textStyle="bold"
                                    android:textColor="@color/pulse_text_secondary"
                                    android:includeFontPadding="false"
                                    android:layout_marginStart="4dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Stride length calculation preview pill -->
                        <TextView
                            android:id="@+id/text_onboarding_stride_preview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/onboarding_stride_preview_default"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/pulse_sky_blue" />

                        <!-- Measuring Tape Ruler Slider (Height) -->
                        <com.pulse.tracker.ui.common.RulerTapeView
                            android:id="@+id/ruler_onboarding_height"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginTop="16dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
