<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_onboarding_page1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="24dp"
        android:paddingBottom="130dp">

        <!-- Pulse Hero Logo Ball -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/img_onboarding_hero"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/ic_logo_ball"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_step1_title"
                android:textSize="30sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:textColor="@color/pulse_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/onboarding_step1_subtitle"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/pulse_text_secondary" />
        </LinearLayout>

        <!-- Bento Card: Profile Identity / Name (Solid Neutral #222222, 28dp radius) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_onboarding_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/pulse_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_12">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tab_profile"
                        app:tint="@color/pulse_sky_blue"
                        android:contentDescription="@null"
                        android:layout_marginEnd="@dimen/space_12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_display_name"
                        android:textAppearance="@style/TextAppearance.Pulse.TitleLarge"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_text_primary" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/pulse_surface_alt">

                    <EditText
                        android:id="@+id/input_onboarding_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/minimum_touch_target"
                        android:background="@android:color/transparent"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:hint="@string/onboarding_name_hint"
                        android:textColorHint="@color/pulse_text_tertiary"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:inputType="textPersonName|textCapWords"
                        android:imeOptions="actionDone"
                        android:maxLines="1" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bento Card: Measurement Units (Solid Neutral #222222, 28dp radius) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_onboarding_units"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/pulse_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_12">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sliders"
                        app:tint="@color/pulse_yellow"
                        android:contentDescription="@null"
                        android:layout_marginEnd="@dimen/space_12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_units"
                        android:textAppearance="@style/TextAppearance.Pulse.TitleLarge"
                        android:textStyle="bold"
                        android:textColor="@color/pulse_text_primary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_onboarding_units"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@+id/btn_onboarding_unit_metric">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_onboarding_unit_metric"
                        style="@style/Widget.Pulse.Button.Toggle.Yellow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_unit_metric" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_onboarding_unit_imperial"
                        style="@style/Widget.Pulse.Button.Toggle.Yellow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_unit_imperial" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Helpful Explanatory Example Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_unit_explanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/pulse_surface_alt">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/text_unit_system_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/unit_metric_name"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="@color/pulse_text_primary" />

                        <TextView
                            android:id="@+id/text_unit_system_example"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/unit_metric_example"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/pulse_text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
